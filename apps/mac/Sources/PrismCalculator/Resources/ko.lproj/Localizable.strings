/* Currency */
"%@ · ECB / Frankfurter · Daily reference rate" = "%@ · ECB / Frankfurter · 일일 기준 환율";
"Cached · refresh unavailable · %@ · ECB / Frankfurter · Daily reference rate" = "저장된 환율 · 갱신 불가 · %@ · ECB / Frankfurter · 일일 기준 환율";
