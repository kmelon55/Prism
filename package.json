{
  "name": "prism",
  "version": "0.2.0",
  "private": true,
  "description": "An open-source, keyboard-first launcher for macOS.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "cd apps/mac && swift build",
    "test": "cd apps/mac && swift test && cd ../.. && node --test scripts/*.test.mjs",
    "macos:signing:setup": "node scripts/setup-local-macos-signing.mjs",
    "macos:signing:verify": "node scripts/verify-macos-signing.mjs",
    "macos:package": "node scripts/package-native-release.mjs",
    "macos:install": "node scripts/install-macos-app.mjs"
  }
}
